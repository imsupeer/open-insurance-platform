{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openinsure.local/contracts/events/claim-notification-v1.json",
  "title": "Claim processing failure notification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "claimId", "failureReason"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "claimId": { "type": "string", "format": "uuid" },
    "failureReason": { "type": "string", "maxLength": 500 },
    "correlationId": { "type": "string", "maxLength": 100 }
  }
}
